    boolean isMessageViewedToastEnabled() { return messages; }
    boolean isStatusViewedToastEnabled() { return statuses; }

    public static class Jid {
        final String raw;
        Jid(String raw) { this.raw = raw; }
        public String getRawString() { return raw; }
        @Override public String toString() { throw new AssertionError("Do not stringify host objects"); }
    }
    public static class UserJid extends Jid { UserJid(String raw) { super(raw); } }
    public static final class DeviceJid extends Jid {
        public final UserJid userJid;
