            this.device = device; this.viewer = viewer; this.message = message; this.type = type; this.time = time;
        }
    }
    public static class StatusBase {
        public final Jid sender;
        public final Key messageKey;
        StatusBase(Key key) { sender = new Jid("0@s.whatsapp.net"); messageKey = key; }
    }
    public static final class StatusKey extends StatusBase {
        public final String id;
        public final boolean own;
        public final Jid senderAgain;
        public final Jid chatAgain;
        StatusKey(Key key) { super(key); id = key.id; own = key.fromMe; senderAgain = sender; chatAgain = key.chat; }
    }
    public static class StatusItem {
        public final StatusKey key;
        public Long rowId;
        public Long unrelatedNumber;
        StatusItem(Key key) { this.key = new StatusKey(key); }
