    }
    public static final class Key {
        public final String id;
        public final boolean fromMe;
        public final Jid chat;
        Key(String id, boolean own, String chat) { this.id = id; fromMe = own; this.chat = new Jid(chat); }
    }
    public static class HostMessage {
        public final Key canonical;
        public Key unrelated;
        HostMessage(Key key) { canonical = key; unrelated = new Key("decoy", false, "666@lid"); }
