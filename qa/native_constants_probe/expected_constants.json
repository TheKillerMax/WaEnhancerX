    "hmaActiveCheckCommand": {
      "return_type": "String",
      "value": "[ -d /data/adb/modules/hma_oss_zygisk ] && [ ! -f /data/adb/modules/hma_oss_zygisk/disable ] && echo active; ls -d /data/adb/modules/*hma* /data/adb/modules/*hide_my_applist* 2>/dev/null; ls -d /data/data/org.frknkrc44.hma_oss /data/data/com.tsng.hidemyapplist /data/data/com.google.android.hmal 2>/dev/null; ls /data/adb/hma*/config.json /data/misc/hide_my_applist*/config.json /data/system/*hide_my_applist*/config.json 2>/dev/null; true"
    },
    "lspHmaCheckCommand": {
      "return_type": "String",
      "value": "[ -f /data/adb/lspd/config/modules_config.db ] && (grep -E 'hidemyapp|hma' /data/adb/lspd/config/modules_config.db 2>/dev/null || sqlite3 /data/adb/lspd/config/modules_config.db \"SELECT 1 FROM modules WHERE (module_pkg_name LIKE '%hidemyapp%' OR module_pkg_name LIKE '%hma%') AND enabled = 1 LIMIT 1\" 2>/dev/null); true"
    },
    "hmaShallowSearchCommand": {
      "return_type": "String",
      "value": "find /data/misc /data/adb /data/system -maxdepth 3 -name '*config.json' 2>/dev/null; true"
    },
    "hmaConfigGlobCommand": {
      "return_type": "String",
      "value": "ls /data/misc/hide_my_applist*/config.json /data/system/users/*/hide_my_applist*/config.json /data/adb/modules/*hma*/config.json /data/adb/modules/*hide_my_applist*/config.json 2>/dev/null; true"
