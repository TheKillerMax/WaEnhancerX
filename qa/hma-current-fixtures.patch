+        assertEquals(HmaDiagnostics.HmaState.UNAVAILABLE, report().state)
@@ -792,0 +793,21 @@ class HmaFlowTest {
+    @Test fun failedDiscoveryIsUnavailableAndCannotRepair() {
+        add(document()); control.put("mode", "discovery_failed"); save()
+        assertEquals(HmaDiagnostics.HmaState.UNAVAILABLE, report().state)
+        assertFalse(repair()); assertTrue(writes().isEmpty())
+    }
+
+    @Test fun unacknowledgedDiscoveryCannotSupplyCleanEvidence() {
+        add(document()); control.put("mode", "discovery_unacknowledged"); save()
+        assertEquals(HmaDiagnostics.HmaState.UNAVAILABLE, report().state)
+    }
+
+    @Test fun truncatedDiscoveryIsUnavailableEvenWithTerminalMarker() {
+        add(document()); control.put("mode", "discovery_truncated"); save()
+        assertEquals(HmaDiagnostics.HmaState.UNAVAILABLE, report().state)
+    }
+
+    @Test fun acknowledgedEmptyDiscoveryDiffersFromFailure() {
+        assertEquals(HmaDiagnostics.HmaState.NOT_CONFIGURED, report().state)
+        assertFalse(repair()); assertTrue(writes().isEmpty())
+    }
+
